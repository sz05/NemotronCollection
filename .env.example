# Server-side Gemini key used for the feedback side-panel. Never commit the real value.
GEMINI_API_KEY=

# Async Postgres connection string.
# Local dev default: peer-auth via unix socket for the current OS user, no password needed.
# For a TCP/password setup instead, use: postgresql+asyncpg://user:pass@localhost:5432/harness
DATABASE_URL=postgresql+asyncpg://harness_user@/harness?host=/var/run/postgresql

# CORS origin for the Vite dev server
FRONTEND_ORIGIN=http://localhost:5173

# NOTE: the Nemotron API key is intentionally NOT configured here.
# It is supplied by the user per-session via the frontend and forwarded
# per-request only — it must never be stored in .env, logs, or the database.

# Nemotron model + endpoint are not secret, just config. Default in
# app/config.py is the lightweight nvidia/llama-3.1-nemotron-nano-8b-v1 on
# build.nvidia.com (the 49B super model was consistently slow/timing out);
# override here for a different model/host, e.g. the larger reasoning model:
# NEMOTRON_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
# NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
# NEMOTRON_MAX_TOKENS=512

# Gemini model, not secret, just config. Default is a lightweight model
# (gemini-3.5-flash-lite) called via the Interactions API; override if
# your AI Studio key needs a different one.
# GEMINI_MODEL=gemini-3.5-flash-lite
