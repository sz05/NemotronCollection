# Copy to .env and fill in. .env is gitignored -- never commit real secrets.

# Server-side Gemini key used for the feedback side-panel. Never commit the real value.
GEMINI_API_KEY=

# Async Postgres connection string.
# Local dev default: peer-auth via unix socket for the current OS user, no password needed.
# For a TCP/password setup instead, use: postgresql+asyncpg://user:pass@localhost:5432/harness
DATABASE_URL=postgresql+asyncpg://harness_user@/harness?host=/var/run/postgresql

# Comma-separated CORS origins (no trailing slashes): Vite dev + deployed frontend.
FRONTEND_ORIGIN=http://localhost:5173

# --- Auth secrets (REQUIRED for any non-local deployment) ---
# Both must be long, random, and DISTINCT. Generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Signs the session JWT (httpOnly cookie). Changing it logs everyone out.
# A weak/guessable value lets an attacker forge sessions -- account takeover.
JWT_SECRET=
# Separate secret used ONLY to encrypt stored Nemotron API keys (key
# separation: a leaked JWT_SECRET must not also decrypt stored keys). Falls
# back to JWT_SECRET when empty (local dev only). Changing it invalidates
# already-stored keys, so affected users just re-enter their key.
API_KEY_ENC_SECRET=

# Google OAuth 2.0 Web client ID (Google Cloud Console > Credentials). The
# login button stays hidden until this is set. Not secret, but env-specific.
GOOGLE_CLIENT_ID=

# Comma-separated emails granted admin rights (proof review + point awards,
# task creation). Everyone else is a normal participant. e.g.:
# ADMIN_EMAILS=you@example.com,cohost@example.com
ADMIN_EMAILS=

# Dev-only email login (no password) for local testing without Google.
# MUST stay false in production -- true = anyone can log in as any email.
DEV_AUTH=false

# Auth cookie SameSite policy. "lax" for same-site (localhost dev). Set "none"
# when frontend and backend are on different domains (e.g. Vercel + Railway);
# "none" forces Secure=True, so the backend must be served over HTTPS.
# COOKIE_SAMESITE=lax

# NOTE: the Nemotron API key is intentionally NOT configured here.
# It is supplied by the user per-session via the frontend and forwarded
# per-request only -- it must never be stored in .env, logs, or the database.

# Nemotron model + endpoint are not secret, just config. Default in
# app/config.py is nvidia/nemotron-3-super-120b-a12b (a reasoning model).
# Override here for a different model/host. max_tokens must cover the model's
# chain-of-thought AND its answer (default 8192); raise for long code turns.
# NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b
# NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
# NEMOTRON_MAX_TOKENS=8192

# Gemini model, not secret, just config. Default is a lightweight model
# (gemini-3.5-flash-lite) called via the Interactions API; override if
# your AI Studio key needs a different one.
# GEMINI_MODEL=gemini-3.5-flash-lite

# --- Proof uploads ---
# Where uploaded proof files are written and the per-file size cap (bytes).
# NOTE: local disk is ephemeral on most PaaS -- files are lost on redeploy.
# PROOF_UPLOAD_DIR=uploads
# PROOF_MAX_BYTES=10000000
